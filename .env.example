# Copy to .env and fill in. .env is gitignored.
#
# PostgreSQL — the system of record. Unset means datasets are generated in
# memory instead; the app runs either way and reports which on /api/health.
MULETRACE_POSTGRES_URL=postgresql://postgres:CHANGE-ME@127.0.0.1:5432/muletrace

# Only needed so the app can CREATE the database on first run. Drop it once the
# database exists.
MULETRACE_POSTGRES_ADMIN_URL=postgresql://postgres:CHANGE-ME@127.0.0.1:5432/postgres

# Redis — working copy and detection patterns. Defaults to localhost.
# MULETRACE_REDIS_URL=redis://127.0.0.1:6379/0

# Password + TOTP gate. "off" runs the console open for a rehearsal.
# MULETRACE_AUTH=on

# How much of the feed the rule engine treats as "now", in hours.
# MULETRACE_RULE_WINDOW_HOURS=168
